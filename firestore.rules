rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember(roomId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
    }

    match /rooms/{roomId} {
      // 초대 링크: 로그인한 사용자는 방 정보를 읽을 수 있어야 함
      allow read: if request.auth != null;

      allow create: if request.auth != null;

      // 기존 멤버 수정 또는 본인만 memberIds에 추가 (초대 참여)
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.memberIds
        || (
          request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        )
      );

      match /messages/{messageId} {
        allow read, update, delete: if isMember(roomId);
        allow create: if isMember(roomId);
      }

      match /readStatus/{userId} {
        allow read: if isMember(roomId);
        allow write: if isMember(roomId) && request.auth.uid == userId;
      }

      match /typing/{userId} {
        allow read: if isMember(roomId);
        allow write: if isMember(roomId) && request.auth.uid == userId;
      }

      match /moods/{userId} {
        allow read: if isMember(roomId);
        allow write: if isMember(roomId) && request.auth.uid == userId;
      }

      match /locations/{userId} {
        allow read: if isMember(roomId);
        allow write: if isMember(roomId) && request.auth.uid == userId;
      }

      match /ranks/{userId} {
        allow read: if isMember(roomId);
        allow write: if isMember(roomId);
      }

      match /mutes/{userId} {
        allow read: if isMember(roomId);
        allow write: if isMember(roomId);
      }

      match /meta/{docId} {
        allow read: if isMember(roomId);
        allow write: if isMember(roomId);
      }

      match /scheduledMessages/{messageId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId);
        allow update: if isMember(roomId);
      }
    }
  }
}
