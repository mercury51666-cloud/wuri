rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function isMember(roomId) {

      return request.auth != null

        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;

    }



    function onlyReactionsChanged() {

      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);

    }



    // "나에게서만 삭제" — 본인 uid 하나만 hiddenFor 배열에 추가하는 변경만 허용한다.

    function onlySelfHiddenForAdded() {

      let before = resource.data.get('hiddenFor', []);

      let after = request.resource.data.hiddenFor;

      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])

        && after is list

        && after.hasAll(before)

        && after.hasAny([request.auth.uid])

        && after.size() == before.size() + 1;

    }



    match /users/{userId} {

      allow read: if request.auth != null;

      allow write: if request.auth != null && request.auth.uid == userId;



      // 개인 AI 챗 기록 — 본인만 읽고 쓸 수 있다 (방 사람들에게 절대 안 보임).

      match /aiMessages/{messageId} {

        allow read, write: if request.auth != null && request.auth.uid == userId;

      }

    }



    match /rooms/{roomId} {

      allow read: if request.auth != null;



      allow create: if request.auth != null

        && request.auth.uid in request.resource.data.memberIds;



      allow update: if request.auth != null && (

        request.auth.uid in resource.data.memberIds

        || (

          request.auth.uid in request.resource.data.memberIds

          && request.resource.data.memberIds.hasAll(resource.data.memberIds)

          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1

        )

      );



      match /messages/{messageId} {

        allow read: if isMember(roomId);

        allow create: if isMember(roomId);

        allow delete: if isMember(roomId) && request.auth.uid == resource.data.authorId;

        allow update: if isMember(roomId) && (

          request.auth.uid == resource.data.authorId

          || onlyReactionsChanged()

          || onlySelfHiddenForAdded()

        );

      }



      match /readStatus/{userId} {

        allow read: if isMember(roomId);

        allow write: if isMember(roomId) && request.auth.uid == userId;

      }



      match /typing/{userId} {

        allow read: if isMember(roomId);

        allow write: if isMember(roomId) && request.auth.uid == userId;

      }



      match /moods/{userId} {

        allow read: if isMember(roomId);

        allow write: if isMember(roomId) && request.auth.uid == userId;

      }



      match /locations/{userId} {

        allow read: if isMember(roomId);

        allow write: if isMember(roomId) && request.auth.uid == userId;

      }



      match /nowPlaying/{userId} {

        allow read: if isMember(roomId);

        allow write: if isMember(roomId) && request.auth.uid == userId;

      }



      match /ranks/{userId} {

        allow read: if isMember(roomId);

        allow write: if isMember(roomId) && request.auth.uid == userId;

      }



      match /mutes/{userId} {

        allow read: if isMember(roomId);

        allow write: if isMember(roomId) && request.auth.uid != userId;

      }



      match /meta/{docId} {

        allow read: if isMember(roomId);

        allow write: if isMember(roomId);

      }



      match /scheduledMessages/{messageId} {

        allow read: if isMember(roomId);

        allow create: if isMember(roomId);

        allow update: if isMember(roomId);

      }



      match /events/{eventId} {

        allow read: if isMember(roomId);

        allow create: if isMember(roomId);

        allow update, delete: if isMember(roomId) && request.auth.uid == resource.data.authorId;



        match /rsvp/{userId} {

          allow read: if isMember(roomId);

          allow write: if isMember(roomId) && request.auth.uid == userId;

        }

      }

    }

  }

}

