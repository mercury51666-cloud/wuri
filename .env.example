# Firebase (Firebase Console → 프로젝트 설정 → 내 앱)
# authDomain은 반드시 xxx.firebaseapp.com 형식 (Vercel URL 아님)
# Firebase Console → Authentication → Settings → Authorized domains 에
# wuri-iota.vercel.app (또는 사용 중인 도메인) 추가 필요
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 웹 푸시 (앱을 나가거나 완전히 종료해도 새 메시지 알림)
# Firebase 콘솔 → 프로젝트 설정 → Cloud Messaging 탭 → "웹 구성" → Web Push 인증서
# → 키 쌍 생성 → 생성된 키를 아래에 붙여넣기
VITE_FIREBASE_VAPID_KEY=

# Cloudinary (이미지 업로드 — unsigned preset)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# --- 아래는 Vite(.env)가 아니라 Vercel 프로젝트 환경 변수에만 등록! ---
# (VITE_ 접두사가 없어야 클라이언트 번들에 노출되지 않음)
# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성(JSON 다운로드)
# 서버(Vercel Function)에서 푸시를 실제로 전송(firebase-admin)할 때 사용
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=   ("BEGIN PRIVATE KEY"~"END PRIVATE KEY" 전체, \n 포함)
